---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Notes from the Astra template demo.">
  <section class="theme-dark section-pad">
    <div class="site-shell motion-fade-up">
      <p class="font-display text-3xl text-[var(--color-accent)] mb-3">Astra</p>
      <h1 class="text-4xl md:text-6xl">Blog</h1>
      <p class="mt-4 max-w-xl text-lg text-[var(--color-fg-muted)]">
        Short notes that show how the optional blog collection works alongside block pages.
      </p>
    </div>
  </section>

  <section class="theme-light section-pad">
    <div class="site-shell">
      <ul class="motion-stagger grid gap-8 md:grid-cols-2">
        {
          posts.map((post) => (
            <li class="border-t border-[var(--color-border)] pt-5">
              <p class="text-sm text-[var(--color-fg-muted)]">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </p>
              <h2 class="font-display text-2xl mt-2">
                <a href={`/blog/${post.id}/`} class="hover:underline underline-offset-4">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-[var(--color-fg-muted)]">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
