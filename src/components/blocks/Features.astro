---
import { themeClass, type Block } from '../../lib/blocks';

type Props = Extract<Block, { type: 'features' }>;
const { theme = 'light', variant = 'default', heading, text, items = [] } = Astro.props;
const compact = variant === 'compact';
const split = variant === 'split';
---

<section class:list={[themeClass(theme), 'section-pad']}>
  <div class="site-shell">
    {
      (heading || text) && (
        <div class:list={['mb-10 max-w-2xl motion-fade-up', split && 'lg:mb-14']}>
          {heading && <h2 class="text-3xl md:text-4xl text-balance">{heading}</h2>}
          {text && <p class="mt-3 text-lg text-[var(--color-fg-muted)]">{text}</p>}
        </div>
      )
    }

    <ul
      class:list={[
        'motion-stagger grid gap-x-10 gap-y-8',
        compact ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3',
        split ? 'lg:grid-cols-2' : '',
      ]}
    >
      {
        items.map((item) => (
          <li class="border-t border-[var(--color-border)] pt-5">
            <h3 class="font-display text-xl md:text-2xl">{item.title}</h3>
            <p class="mt-2 text-[var(--color-fg-muted)] text-pretty">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
