---
import { getCollection } from 'astro:content';
import { themeClass, type Block } from '../../lib/blocks';

type Props = Extract<Block, { type: 'blogRoll' }>;
const { theme = 'light', variant = 'default', heading, text, limit = 3 } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);

const compact = variant === 'compact';
const split = variant === 'split';
---

<section class:list={[themeClass(theme), 'section-pad']}>
  <div class="site-shell">
    <div class:list={['mb-8 max-w-2xl motion-fade-up', split && 'lg:mb-10']}>
      {heading && <h2 class="text-3xl md:text-4xl text-balance">{heading}</h2>}
      {text && <p class="mt-3 text-lg text-[var(--color-fg-muted)]">{text}</p>}
    </div>

    {
      posts.length === 0 ? (
        <p class="text-[var(--color-fg-muted)]">No posts yet.</p>
      ) : (
        <ul
          class:list={[
            'motion-stagger grid gap-8',
            compact ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3',
            split ? 'lg:grid-cols-2' : '',
          ]}
        >
          {posts.map((post) => (
            <li class="border-t border-[var(--color-border)] pt-5">
              <p class="text-sm text-[var(--color-fg-muted)]">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </p>
              <h3 class="font-display text-xl md:text-2xl mt-2">
                <a href={`/blog/${post.id}/`} class="hover:underline underline-offset-4">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-2 text-[var(--color-fg-muted)] text-pretty">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
