---
import { themeClass, type Block } from '../../lib/blocks';

type Props = Extract<Block, { type: 'logos' }>;
const { theme = 'light', variant = 'default', heading, items = [] } = Astro.props;
const compact = variant === 'compact';
const band = variant === 'band';
---

<section
  class:list={[
    themeClass(theme),
    band ? 'py-10 border-y border-[var(--color-border)]' : 'section-pad',
  ]}
>
  <div class="site-shell">
    {
      heading && (
        <p class="motion-fade-up mb-6 text-sm uppercase tracking-[0.14em] text-[var(--color-fg-muted)]">
          {heading}
        </p>
      )
    }
    <ul
      class:list={[
        'motion-stagger flex flex-wrap items-center gap-x-8 gap-y-5',
        compact ? 'justify-start' : 'justify-between',
      ]}
    >
      {
        items.map((item) => (
          <li class="min-w-[6.5rem]">
            {item.image ? (
              <img src={item.image} alt={item.name} class="h-8 w-auto opacity-80" loading="lazy" />
            ) : (
              <span class="font-display text-lg md:text-xl text-[var(--color-fg-muted)]">
                {item.name}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
