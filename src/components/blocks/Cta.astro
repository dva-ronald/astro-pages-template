---
import { themeClass, type Block } from '../../lib/blocks';
import { buttonClass, resolveButtons } from '../../lib/links';

type Props = Extract<Block, { type: 'cta' }>;
const {
  theme = 'brand',
  variant = 'default',
  heading,
  text,
  buttons,
  primaryCta,
  secondaryCta,
} = Astro.props;

const ctaButtons = resolveButtons({ buttons, primaryCta, secondaryCta });
const centered = variant === 'centered' || variant === 'default';
const band = variant === 'band';
---

<section class:list={[themeClass(theme), 'section-pad', band && 'border-y border-[var(--color-border)]']}>
  <div
    class:list={[
      'site-shell motion-fade-up',
      centered ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl',
    ]}
  >
    <h2 class="text-3xl md:text-5xl text-balance">{heading}</h2>
    {text && <p class="mt-4 text-lg text-[var(--color-fg-muted)]">{text}</p>}
    {
      ctaButtons.length > 0 && (
        <div class:list={['mt-8 flex flex-wrap gap-3', centered && 'justify-center']}>
          {ctaButtons.map((btn) => (
            <a class={buttonClass(btn.style)} href={btn.href}>
              {btn.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
