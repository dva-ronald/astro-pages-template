---
import { themeClass, type Block } from '../../lib/blocks';
import { renderMarkdown } from '../../lib/markdown';

type Props = Extract<Block, { type: 'faq' }>;
const { theme = 'light', variant = 'default', heading, text, items = [] } = Astro.props;
const compact = variant === 'compact';
const split = variant === 'split';
---

<section class:list={[themeClass(theme), 'section-pad']}>
  <div
    class:list={[
      'site-shell',
      split ? 'grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start' : '',
    ]}
  >
    <div class="motion-fade-up max-w-xl">
      {heading && <h2 class="text-3xl md:text-4xl text-balance">{heading}</h2>}
      {text && <p class="mt-3 text-lg text-[var(--color-fg-muted)]">{text}</p>}
    </div>

    <div class:list={['motion-stagger', compact ? 'space-y-2' : 'space-y-3', !split && 'mt-8']}>
      {
        items.map((item) => (
          <details class="group border-b border-[var(--color-border)] pb-3">
            <summary class="cursor-pointer list-none font-display text-lg md:text-xl py-2 flex items-center justify-between gap-4">
              <span>{item.question}</span>
              <span
                class="text-[var(--color-fg-muted)] transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div
              class="prose-block pt-1 pb-2 text-[var(--color-fg-muted)]"
              set:html={renderMarkdown(item.answer)}
            />
          </details>
        ))
      }
    </div>
  </div>
</section>
